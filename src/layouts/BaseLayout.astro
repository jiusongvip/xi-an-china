---
import "../styles/global.css";
import "@fontsource-variable/lexend";
import "@fontsource-variable/fraunces";
import { orgSchema, personSchema, websiteSchema } from "../utils/schema";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  hasOwnArticle?: boolean;
  hasOwnBreadcrumb?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-default.webp",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = "",
  ogType = "website",
  noindex = false,
  author = "",
  datePublished = "",
  dateModified = datePublished,
  hasOwnArticle = false,
  hasOwnBreadcrumb = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "");
const robotsContent = noindex ? "noindex, follow" : "index, follow";
const ogImageURL = new URL(ogImage, Astro.site).href;
const ogMeta = { width: ogImageWidth, height: ogImageHeight, alt: ogImageAlt || title };

const MONTHS: Record<string, string> = {
  january: "01", february: "02", march: "03", april: "04", may: "05", june: "06",
  july: "07", august: "08", september: "09", october: "10", november: "11", december: "12",
};
// Normalize "August 2026" / "July 2026" → ISO "2026-08-01" for schema.org dates.
function isoDate(v: string): string {
  const m = v.trim().match(/^([A-Za-z]+)\s+(\d{4})$/);
  if (m && MONTHS[m[1].toLowerCase()]) return `${m[2]}-${MONTHS[m[1].toLowerCase()]}-01`;
  const m2 = v.trim().match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m2) return `${m2[1]}-${m2[2]}-${m2[3]}`;
  return v;
}

const pageLabels: Record<string, string> = {
  "attractions": "Attractions",
  "terracotta-warriors": "Terracotta Warriors",
  "city-wall": "Ancient City Wall",
  "muslim-quarter": "Muslim Quarter",
  "mount-huashan": "Mount Huashan",
  "big-wild-goose-pagoda": "Big Wild Goose Pagoda",
  "shaanxi-history-museum": "Shaanxi History Museum",
  "huaqing-pool": "Huaqing Hot Springs",
  "bell-drum-tower": "Bell & Drum Towers",
  "tang-paradise": "Tang Paradise",
  "daming-palace": "Daming Palace",
  "han-yangling": "Han Yangling",
  "blog": "Blog",
  "terracotta-warriors-photography": "Photographing the Terracotta Warriors",
  "xian-4-seasons": "Xi'an in Four Seasons",
  "xian-hidden-gems": "Xi'an Hidden Gems",
  "best-time-to-visit": "Best Time to Visit",
  "china-240-hour-transit-visa": "240-Hour Transit Visa",
  "china-sim-card-tourist": "SIM Card Guide",
  "comparison": "Compare Attractions",
  "contact": "Contact",
  "day-trips": "Day Trips",
  "faq": "FAQ",
  "food": "Food Guide",
  "hotels": "Where to Stay",
  "itineraries": "Itineraries",
  "nightlife": "Nightlife",
  "payment-guide": "Payment Guide",
  "phrasebook": "Phrasebook",
  "privacy": "Privacy Policy",
  "shopping": "Shopping Guide",
  "tickets": "Tickets & Prices",
  "transportation": "Transportation",
  "weather": "Weather Guide",
  "about": "About",
};

const pathParts = Astro.url.pathname.split("/").filter(Boolean);
let crumbs: { name: string; item: string }[] = [];
let breadcrumbSchema = "";

if (pathParts.length > 0) {
  crumbs.push({ name: "Home", item: "/" });
  const base = new URL("/", Astro.site).href.replace(/\/$/, "");
  const items = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": base + "/" }];
  let itemUrl = "";
  for (let i = 0; i < pathParts.length; i++) {
    const part = pathParts[i];
    const name = pageLabels[part] ?? part.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase());
    itemUrl += "/" + part;
    crumbs.push({ name, item: itemUrl });
    items.push({ "@type": "ListItem", "position": i + 2, "name": name, "item": base + itemUrl });
  }
  breadcrumbSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items,
  });
}

const pageHasArticle = Boolean(author && datePublished);
const articleSchema = pageHasArticle
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
      "author": { "@type": "Person", "name": author, "url": "https://xi-an-china.com/about" },
      "publisher": { "@type": "Organization", "name": "Xi'an Guide", "url": "https://xi-an-china.com" },
      "datePublished": isoDate(datePublished),
      "dateModified": isoDate(dateModified || datePublished),
      "image": ogImageURL,
    })
  : "";

const navLinks = [
  { href: "/attractions", label: "Attractions" },
  { href: "/itineraries", label: "Itineraries" },
  { href: "/food", label: "Food" },
  { href: "/weather", label: "Weather" },
  { href: "/day-trips", label: "Day Trips" },
  { href: "/payment-guide", label: "Practical" },
];

const footerCols = [
  {
    label: "Plan",
    links: [
      { href: "/attractions", label: "Attractions" },
      { href: "/itineraries", label: "Itineraries" },
      { href: "/weather", label: "Weather" },
      { href: "/day-trips", label: "Day Trips" },
      { href: "/transportation", label: "Getting There" },
      { href: "/tickets", label: "Tickets" },
    ],
  },
  {
    label: "Explore",
    links: [
      { href: "/attractions/terracotta-warriors", label: "Terracotta Warriors" },
      { href: "/attractions/city-wall", label: "City Wall" },
      { href: "/attractions/muslim-quarter", label: "Muslim Quarter" },
      { href: "/attractions/mount-huashan", label: "Mount Huashan" },
      { href: "/attractions/big-wild-goose-pagoda", label: "Big Wild Goose Pagoda" },
    ],
  },
  {
    label: "Practical",
    links: [
      { href: "/food", label: "Food Guide" },
      { href: "/nightlife", label: "Nightlife" },
      { href: "/shopping", label: "Shopping" },
      { href: "/payment-guide", label: "Payment Guide" },
      { href: "/phrasebook", label: "Phrasebook" },
      { href: "/china-sim-card-tourist", label: "SIM Card" },
      { href: "/china-240-hour-transit-visa", label: "Transit Visa" },
    ],
  },
  {
    label: "More",
    links: [
      { href: "/hotels", label: "Where to Stay" },
      { href: "/best-time-to-visit", label: "Best Time" },
      { href: "/blog", label: "Blog" },
      { href: "/comparison", label: "Compare" },
      { href: "/faq", label: "FAQ" },
    ],
  },
  {
    label: "About",
    links: [
      { href: "/about", label: "Our Story" },
      { href: "/contact", label: "Contact" },
      { href: "/privacy", label: "Privacy Policy" },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f1ea" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Xi'an Guide Team | Li Wei, Wang Fang, Chen Yu" />
    <meta name="robots" content={robotsContent} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {!noindex && <>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogMeta.width)} />
    <meta property="og:image:height" content={String(ogMeta.height)} />
    <meta property="og:image:alt" content={ogMeta.alt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Xi'an Guide" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogMeta.alt} />
    </>}

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema())}></script>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema())}></script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema())}></script>
    {pageHasArticle && !hasOwnArticle && <script type="application/ld+json" set:html={articleSchema}></script>}
    {!noindex && !hasOwnBreadcrumb && breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}

    <!-- Google Analytics 4 — optional; set GA_MEASUREMENT_ID in production -->
    {import.meta.env.PROD && import.meta.env.GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.GA_MEASUREMENT_ID}`}></script>
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${import.meta.env.GA_MEASUREMENT_ID}');`}></script>
      </>
    )}

    <slot name="head" />
  </head>
  <body class="min-h-[100dvh] bg-stone-50 text-stone-800 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-champagne-600 focus:text-white focus:rounded-lg focus:outline-none">Skip to content</a>
    <div class="grain-overlay" aria-hidden="true"></div>

    <header class="fixed top-0 inset-x-0 z-50 border-b border-stone-200/70 bg-stone-50/85 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-6" aria-label="Main">
        <a href="/" class="group flex items-center gap-2.5 no-underline">
          <span class="font-display text-lg tracking-tight text-ink">Xi'an Guide</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          {navLinks.map((l) => (
            <a href={l.href} class="group relative label text-ink-soft transition-colors duration-300 hover:text-champagne-700 no-underline">
              {l.label}
              <span aria-hidden="true" class="absolute left-0 -bottom-1 h-px w-full origin-left scale-x-0 bg-champagne-500 transition-transform duration-300 group-hover:scale-x-100"></span>
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main-content" class="pt-16">
      {!noindex && crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 md:px-6 py-4">
          <ol class="flex flex-wrap items-center gap-2 label text-stone-400">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true" class="text-champagne-300">/</span>}
                {i < crumbs.length - 1 ? (
                  <a href={c.item} class="uppercase tracking-[0.24em] transition-colors hover:text-champagne-600">{c.name}</a>
                ) : (
                  <span class="uppercase tracking-[0.24em] text-ink-soft font-semibold" aria-current="page">{c.name}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}

      {author && (
        <div class="mx-auto max-w-3xl px-4 md:px-6 pt-6">
          <div class="flex items-center gap-4 text-sm text-stone-500 border-b border-stone-200 pb-6 mb-2">
            <span>By <strong class="font-semibold text-ink">{author}</strong></span>
            {datePublished && (
              <>
                <span class="text-champagne-300">|</span>
                <span>Published {datePublished}</span>
              </>
            )}
            {dateModified && dateModified !== datePublished && (
              <>
                <span class="text-champagne-300">|</span>
                <span>Updated {dateModified}</span>
              </>
            )}
          </div>
        </div>
      )}
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-stone-100">
      <div class="mx-auto max-w-7xl px-4 md:px-6 py-16">
        <div class="grid grid-cols-2 md:grid-cols-6 gap-8 md:gap-10">
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="group flex items-center gap-2.5 no-underline mb-4">
              <span class="font-display text-lg tracking-tight text-ink">Xi'an Guide</span>
            </a>
            <p class="text-sm text-stone-500 leading-relaxed">
              Your independent travel guide to Xi'an, China. Practical, honest advice from locals.
            </p>
          </div>
          {footerCols.map((col) => (
            <div>
              <p class="label text-champagne-600 mb-5">{col.label}</p>
              <ul class="flex flex-col gap-2.5">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-[0.72rem] font-medium uppercase tracking-[0.18em] text-stone-600 transition-colors duration-300 hover:text-champagne-600 no-underline">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-12 pt-8 border-t border-stone-200 text-center text-sm text-stone-500">
          <p>Xi'an Guide &copy; 2026. An independent travel resource. Not affiliated with any tourism board.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function(){if(!window.matchMedia("(prefers-reduced-motion: reduce)").matches){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("reveal-in");o.unobserve(e.target)}})},{threshold:0.1,rootMargin:"0px 0px -40px 0px"});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})}})();
    </script>

    <script>
      import Lenis from "lenis";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduced) {
        const lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // smooth anchor in-page jumps under Lenis
        document.querySelectorAll('a[href^="#"]').forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (!id || id.length < 2) return;
            const el = document.querySelector(id) as HTMLElement | null;
            if (!el) return;
            e.preventDefault();
            lenis.scrollTo(el, { offset: -72, duration: 1.1 });
          });
        });
      }
    </script>
  </body>
</html>