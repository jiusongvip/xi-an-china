    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://xi-an-china.com/" },
      { "@type": "ListItem", "position": 2, "name": "Attractions", "item": "https://xi-an-china.com/attractions" },
      { "@type": "ListItem", "position": 3, "name": "Huaqing Hot Springs: Tang Dynasty Imperial Baths", "item": "https://xi-an-china.com/attractions/huaqing-pool/" }
    ]},
    { "@type": "FAQPage", "mainEntity": [{"@type":"Question","name":"Is Huaqing Pool worth visiting?","acceptedAnswer":{"@type":"Answer","text":"Yes, especially combined with the Terracotta Warriors (10 min away). On its own, it is a pleasant historical site but not a must-see. As part of a Warriors + Huaqing day trip, it is excellent."}},
{"@type":"Question","name":"Can you bathe in the hot springs?","acceptedAnswer":{"@type":"Answer","text":"Yes, but not in the historical pools (viewing only). A separate modern spa area lets you soak in the same natural hot spring water. Tickets $30-$60."}},
{"@type":"Question","name":"Is the night show worth it?","acceptedAnswer":{"@type":"Answer","text":"Yes, it is spectacular — a full-scale outdoor production with hundreds of performers and the mountain itself as a backdrop. Book weeks ahead for peak season."}},
