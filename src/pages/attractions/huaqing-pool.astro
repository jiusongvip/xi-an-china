const pageTitle = "Huaqing Hot Springs — History & Visitor Guide";
const pageDesc = "Tang Dynasty hot spring palace where emperors wintered. Explore imperial baths and the love story of Xuanzong and Yang Guifei. Combine with Terracotta Warriors.";

const faqs = [
  { q: "Is Huaqing Pool worth visiting?", a: "Yes, especially combined with the Terracotta Warriors (10 min away). On its own, it is a pleasant historical site but not a must-see. As part of a Warriors + Huaqing day trip, it is excellent." },
  { q: "Can you bathe in the hot springs?", a: "Yes, but not in the historical pools (viewing only). A separate modern spa area lets you soak in the same natural hot spring water. Tickets $30-$60." },
  { q: "Is the night show worth it?", a: "Yes, it is spectacular — a full-scale outdoor production with hundreds of performers and the mountain itself as a backdrop. Book weeks ahead for peak season." },
];

