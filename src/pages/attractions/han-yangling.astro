const pageTitle = "Han Yangling — The Quieter Terracotta Army";
const pageDesc = "Han Dynasty mausoleum with thousands of miniature terracotta figurines, glass-floored walkways, and almost no crowds. A hidden gem 40 minutes from Xi'an.";

const faqs = [
  { q: "Is Han Yangling worth visiting if I’ve seen the Terracotta Warriors?", a: "Absolutely. It is a completely different experience — miniature figurines instead of life-sized, glass-floored pits instead of open hangars, and peaceful solitude instead of crowds. Many visitors prefer the intimate atmosphere here." },
  { q: "How do I get to Han Yangling?", a: "Taxi from downtown: 40 min, $12-$15. Metro Line 2 to Shitushuguan Station, then bus or taxi (10-15 min). It is less convenient than the Warriors but the solitude is the reward." },
  { q: "How is it different from the Terracotta Warriors?", a: "Size: 60 cm figures vs. life-sized. Era: Han Dynasty (202 BC) vs. Qin (210 BC). Crowds: dozens per day vs. thousands. Experience: quiet and contemplative vs. bustling and spectacular. They complement rather than compete with each other." },
  { q: "How does Han Yangling compare to the Terracotta Warriors?", a: "Terracotta Warriors: massive scale, life-size figures, huge crowds, busier experience. Han Yangling: intimate glass-floor walkways, smaller but more detailed figures, far fewer visitors, more atmospheric. If you love history and archaeology, see both — they complement each other perfectly. If you can only see one, the Warriors are more iconic, but Han Yangling may be the more memorable personal experience." },
];

const schema = {
