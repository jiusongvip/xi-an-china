  <style>
    .hw-wrap {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
      padding-block: 0.08em;
      margin-block: -0.08em;
    }
    .hw {
      transform: translateY(0);
      will-change: transform;
    }
    .day-img {
      clip-path: inset(0 0 0 0);
    }
    .day-copy {
      opacity: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .day-img {
        clip-path: inset(0 0 0 0);
      }
      .day-copy {
        opacity: 1;
      }
      .hw {
        transform: none;
      }
    }
  </style>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const loader = document.getElementById("xl-loader")!;
    const brand = "XI'AN GUIDE";
    const typeProxy = { val: 0 };

    const heroWords = Array.from(document.querySelectorAll<HTMLElement>(".hw"));
    const heroSlides = Array.from(document.querySelectorAll<HTMLElement>(".hero-slide"));
    const heroTicks = Array.from(document.querySelectorAll<HTMLElement>(".hero-tick"));
    const box = document.getElementById("xl-loader-box")!;
    const boxImgs = Array.from(document.querySelectorAll<HTMLElement>(".xl-loader-img"));

    const HOLD = 3.2;
    const FADE = 1.4;
    const STEP = HOLD + FADE;

    function heroIn() {
      // word-by-word headline reveal
      gsap.set(heroWords, { yPercent: 125 });
      gsap.to(heroWords, { yPercent: 0, duration: 0.9, ease: "power3.out", stagger: 0.08 });
      // 6-frame carousel: 1400ms crossfade, hold, loop
      const carousel = gsap.timeline({ repeat: -1, delay: 0.35 });
      for (let i = 1; i < heroSlides.length; i++) {
        const at = (i - 1) * STEP;
        carousel.to(heroSlides[i], { opacity: 1, duration: FADE, ease: "power1.inOut" }, at);
        carousel.set(heroSlides.slice(0, i), { opacity: 0 }, at + FADE);
        carousel.call(() => setTick(i), undefined, at);
      }
      // restore frame 0 at loop end so the wrap is seamless
      const total = (heroSlides.length - 1) * STEP;
      carousel.set(heroSlides.slice(1), { opacity: 0 }, total);
      carousel.set(heroSlides[0], { opacity: 1 }, total);
      carousel.call(() => setTick(0), undefined, total);
    }

    function setTick(i: number) {
      heroTicks.forEach((t, k) => {
        t.className = k === i ? "hero-tick block h-px w-7 bg-champagne-500" : "hero-tick block h-px w-3 bg-stone-500/60";
      });
    }

    function runLoader() {
      loader.style.visibility = "visible";
      gsap.set(box, { scaleX: 0, scaleY: 0, transformOrigin: "center center" });

      const tl = gsap.timeline();
      // type-on the two-word brand
      tl.to(typeProxy, {
        val: brand.length,
        duration: 0.7,
        ease: "none",
        onUpdate: () => { (document.getElementById("xl-loader-word")!).textContent = brand.slice(0, Math.round(typeProxy.val)); },
      });
      // empty box grows
      tl.to(box, { scaleX: 1, scaleY: 1, duration: 0.55, ease: "power3.inOut" }, 0.45);
      // three images cross-develop inside the box
      boxImgs.forEach((im, i) => {
        tl.to(im, { opacity: 1, duration: 0.35, ease: "power1.out" }, 0.95 + i * 0.13);
      });
      // loader slides away, revealing the hero (first frame already decoded)
      tl.to(loader, { yPercent: -100, duration: 0.7, ease: "power3.inOut", onComplete: () => loader.remove() }, 1.55);
      tl.add(heroIn, 1.5);
      try { sessionStorage.setItem("xl-loader", "1"); } catch (_) {}
    }

    function initDay() {
      // sticky-features scrub — vertical clip-path tear + scale3d rail
      gsap.set(Array.from(document.querySelectorAll<HTMLElement>(".day-img")), { clipPath: "inset(50% 0% 50% 0%)" });
      gsap.set(Array.from(document.querySelectorAll<HTMLElement>(".day-copy")), { opacity: 0 });
      gsap.set("#day-rail-fill", { transform: "scale3d(1,0,1)" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#day-wrap",
          start: "top top",
          end: "bottom bottom",
          scrub: 0.6,
        },
      });
      const stage = [
        { img: 0, copy: 0 },
        { img: 1, copy: 1 },
        { img: 2, copy: 2 },
      ];
      stage.forEach((s, i) => {
        const at = i / 3;
        tl.to(`[data-stage="${s.img}"]`, { clipPath: "inset(0% 0% 0% 0%)", duration: 1 / 3, ease: "power1.inOut" }, at);
        tl.to(`#day-copy-${s.copy}`, { opacity: 1, duration: 0.35, ease: "power1.out" }, at + 0.08);
      });
      tl.to("#day-rail-fill", { transform: "scale3d(1,1,1)", duration: 1, ease: "none" }, 0);
      ScrollTrigger.refresh();
    }

    if (!reduced) {
      const seen = (() => { try { return sessionStorage.getItem("xl-loader") === "1"; } catch (_) { return false; } })();
      if (seen) { heroIn(); } else { runLoader(); }
      initDay();
    }
  </script>
