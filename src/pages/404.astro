---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Page Not Found — Xi'an Guide";
const pageDesc = "The page you are looking for does not exist. Explore our Xi'an travel guides — Terracotta Warriors, City Wall, Muslim Quarter food, and more.";
---
<BaseLayout title={pageTitle} description={pageDesc} noindex>
  <section class="mx-auto max-w-3xl px-4 md:px-6 py-24 md:py-32 text-center">
    <p class="flex items-center justify-center gap-3 text-xs font-semibold tracking-[0.2em] uppercase text-terracotta-600">
      <span class="inline-block w-8 h-px bg-terracotta-500/60"></span>
      404 · 找不到了
      <span class="inline-block w-8 h-px bg-terracotta-500/60"></span>
    </p>
    <h1 class="mt-4 text-4xl md:text-6xl font-semibold tracking-tight text-stone-900">This page has wandered off the Silk Road</h1>
    <p class="mt-5 text-lg text-stone-500 max-w-md mx-auto leading-relaxed">
      The page you are looking for does not exist or has moved. Here are a few places our readers find most useful:
    </p>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-lg mx-auto text-left">
      <a href="/attractions/terracotta-warriors" class="group rounded-xl border border-stone-200 bg-white p-5 no-underline hover:border-terracotta-200 hover:shadow-md transition-all">
        <p class="font-semibold text-stone-900 group-hover:text-terracotta-700">Terracotta Warriors</p>
        <p class="text-sm text-stone-500 mt-1">Tickets, timing &amp; crowd-beating tips</p>
      </a>
      <a href="/itineraries" class="group rounded-xl border border-stone-200 bg-white p-5 no-underline hover:border-terracotta-200 hover:shadow-md transition-all">
        <p class="font-semibold text-stone-900 group-hover:text-terracotta-700">Itineraries</p>
        <p class="text-sm text-stone-500 mt-1">1, 3, and 5-day plans with budgets</p>
      </a>
      <a href="/food" class="group rounded-xl border border-stone-200 bg-white p-5 no-underline hover:border-terracotta-200 hover:shadow-md transition-all">
        <p class="font-semibold text-stone-900 group-hover:text-terracotta-700">Food Guide</p>
        <p class="text-sm text-stone-500 mt-1">20 must-try dishes &amp; where to find them</p>
      </a>
      <a href="/" class="group rounded-xl border border-stone-200 bg-white p-5 no-underline hover:border-terracotta-200 hover:shadow-md transition-all">
        <p class="font-semibold text-stone-900 group-hover:text-terracotta-700">Homepage</p>
        <p class="text-sm text-stone-500 mt-1">Start planning your Xi'an trip</p>
      </a>
    </div>
    <div class="mt-10">
      <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-terracotta-500 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-terracotta-600 active:scale-[0.98]">
        Back to Home
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5" /></svg>
      </a>
    </div>
  </section>
</BaseLayout>