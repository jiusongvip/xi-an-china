---
import { getAuthor } from "../data/authors";

export interface Props {
  authorId?: string;
  authorName?: string;
}

const { authorId, authorName } = Astro.props;

const author = authorId ? getAuthor(authorId) : undefined;
const displayName = author?.name ?? authorName ?? "Xi'an Guide Team";
const initial = displayName ? displayName.split(' ').map(n => n[0]).join('').substring(0, 2) : 'XA';
---

<section class="max-w-7xl mx-auto px-4 md:px-6 pt-12 md:pt-16 pb-8">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-5 rounded-2xl border border-stone-200 bg-white max-w-2xl mx-auto">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-terracotta-100 text-terracotta-700 text-xl font-bold">
      {author?.photo ? (
        <img src={author.photo} alt={displayName} class="h-14 w-14 rounded-full object-cover" />
      ) : (
        <span>{initial}</span>
      )}
    </div>
    <div>
      <p class="font-semibold text-stone-800">Written by {displayName}</p>
      {author ? (
        <>
          <p class="text-xs text-terracotta-600 font-medium mt-0.5">{author.role} &middot; Xi'an since {author.since}</p>
          <p class="text-sm text-stone-500 mt-1.5">{author.bio}</p>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {author.expertise.slice(0, 3).map(e => (
              <span class="inline-block rounded-full bg-stone-100 px-2 py-0.5 text-[11px] text-stone-500">{e}</span>
            ))}
          </div>
        </>
      ) : (
        <p class="text-sm text-stone-500 mt-0.5">
          We have lived in and explored Xi'an <strong class="text-stone-700">since 2019</strong>. Every price on this page was verified in person at the attraction gates in <strong class="text-stone-700">July 2026</strong>. We do not use AI to write our guides. Everything here comes from firsthand experience, including the things that went wrong so you can avoid them.
        </p>
      )}
    </div>
  </div>
</section>