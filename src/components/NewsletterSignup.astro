---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Get updated when we verify prices",
  subtitle = "No spam. No ads. Just updated ticket prices, new routes, and seasonal tips for Xi'an — a few times a year.",
} = Astro.props;
---

<section id="newsletter" class="mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20">
  <div class="max-w-2xl mx-auto rounded-2xl border border-stone-200 bg-gradient-to-br from-stone-50 to-white p-8 md:p-10 text-center shadow-sm">
    <p class="label text-champagne-600 mb-5">Newsletter &middot; 订阅</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-stone-900">{title}</h2>
    <p class="mt-3 text-stone-500 text-sm leading-relaxed max-w-lg mx-auto">{subtitle}</p>
    <form
      id="newsletter-form"
      class="mt-6 flex flex-col gap-3 max-w-md mx-auto"
      data-netlify="true"
      name="newsletter"
      method="POST"
      action="/#newsletter"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label for="nl-email" class="sr-only">Email address</label>
      <input
        type="email"
        id="nl-email"
        name="email"
        placeholder="your@email.com"
        autocomplete="email"
        required
        class="w-full px-4 py-3 border-b border-stone-300 bg-transparent text-stone-800 text-sm focus:outline-none focus:border-champagne-500 transition-colors placeholder:text-stone-400"
      />
      <button
        type="submit"
        id="nl-submit"
        class="link-arrow mx-auto"
      >
        Subscribe <span class="link-arrow-ic" aria-hidden="true">→</span>
      </button>
    </form>
    <p id="nl-msg" class="text-xs text-stone-400 mt-3">No spam. Unsubscribe anytime.</p>
  </div>
</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", function () {
  var form = document.getElementById("newsletter-form");
  var msg = document.getElementById("nl-msg");
  var btn = document.getElementById("nl-submit");
  var email = document.getElementById("nl-email");
  if (!form || !msg || !btn) return;
  form.addEventListener("submit", function (e) {
    if (form.querySelector('input[name="_gotcha"]').value) return;
    if (!email.value.trim() || email.value.indexOf("@") < 1) {
      msg.textContent = "Please enter a valid email address.";
      msg.className = "text-xs text-red-600 mt-2 font-medium";
      e.preventDefault();
      return;
    }
    msg.textContent = "Sending...";
    msg.className = "text-xs text-stone-400 mt-2";
    btn.disabled = true;
    var data = new URLSearchParams(new FormData(form));
    fetch("/", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: data.toString(),
    })
      .then(function (res) {
        if (res.ok) {
          msg.textContent = "Thanks! We will be in touch soon.";
          msg.className = "text-xs text-green-600 mt-2 font-medium";
          email.value = "";
        } else {
          msg.textContent = "Something went wrong. Please try again or email us.";
          msg.className = "text-xs text-red-600 mt-2 font-medium";
        }
      })
      .catch(function () {
        msg.textContent = "Something went wrong. Please try again or email us.";
        msg.className = "text-xs text-red-600 mt-2 font-medium";
      })
      .finally(function () {
        btn.disabled = false;
      });
    e.preventDefault();
  });
});
</script>