---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

{
  center ? (
    <div class="text-center max-w-2xl mx-auto">
      {eyebrow && (
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-stone-400 mb-4">{eyebrow}</p>
      )}
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-stone-900 leading-tight">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-stone-500 max-w-xl mx-auto leading-relaxed">{subtitle}</p>
      )}
    </div>
  ) : (
    <div class="max-w-2xl">
      {eyebrow && (
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-stone-400 mb-4">{eyebrow}</p>
      )}
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-stone-900 leading-tight">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-stone-500 max-w-xl leading-relaxed">{subtitle}</p>
      )}
    </div>
  )
}
