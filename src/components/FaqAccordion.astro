---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-stone-200">
  {items.map((item) => (
    <details class="group py-5 cursor-pointer">
      <summary class="flex items-center justify-between gap-4 font-medium text-stone-800 hover:text-terracotta-700 transition-colors list-none">
        {item.q}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400 shrink-0 group-open:rotate-45 transition-transform">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      </summary>
      <p class="mt-3 text-sm text-stone-500 leading-relaxed pr-8" set:html={item.a} />
    </details>
  ))}
</div>
